[43.271, "o", "\u001b[?25l\u001b[?7l\u001b[A\u001b[4D\u001b[0;38;5;173m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m\u001b[K\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;214;1m\u26a0\ufe0f  Dangerous Command                                            \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502                                                                  \u2502\u001b[0m\u001b[K\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;136;3m<terminal> (plugin approval rule)                               \u001b[0;38;5;173m \u2502\u001b[0m\u001b[K\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502                                                                  \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;220;1m\u276f 1. Allow once                                                 \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;136m  2. Allow for this session                                     \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;136m  3. Add to permanent allowlist                                 \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;136m  4. Deny                                                       \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502                                                                  \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;230;1mLights Out: this starts 1 EC2 t3.large: about $60.74/month,     \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;230;1mbilled until deleted. To keep it past this session: /lights keep\u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;230;1m <id> <date>.                                                   \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\r\r\n\u001b[0m \u001b[0m\r\r\n\u001b[0;38;5;136;3m  \u2191/\u2193 to select, Enter to confirm\u001b[0;38;5;173m  (299s)\u001b[0m\r\r\n\u001b[0;38;5;102m\u2500\u2500 \u001b[0;38;5;214;1m\u2826 \u001b[0mWorking\u2026\u001b[0;38;5;101m \u00b7 22s \u00b7 \u2193 281 tok\u001b[0;38;5;102m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[0;38;5;178mLaunch t3.large EC2 and test Postgres database\u001b[0;38;5;102m \r\u001b[117C\u2500\u001b[0m\r\r\n\u001b[0;38;5;136;3m\u26a0 \u276f \u001b[0m\r\r\n\u001b[0;38;5;102m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u