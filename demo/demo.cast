[51.7951, "o", "\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;136m  4. Deny                                                       \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502                                                                  \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;230;1mLights Out: this starts 1 RDS db.t3.micro postgres: about       \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;230;1m$15.44/month incl. 20 GiB storage, billed until deleted. To keep\u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;230;1m it past this session: /lights keep <id> <date>.                \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\r\r\n\u001b[0m \u001b[0m\r\r\n\u001b[0;38;5;136;3m  \u2191/\u2193 to select, Enter to confirm\u001b[0;38;5;173m  (299s)\u001b[0m\r\r\n\u001b[0;38;5;102m\u2500\u2500 \u001b[0;38;5;214;1m\u2819 \u001b[0mWorking\u2026\u001b[0;38;5;101m \u00b7 30s \u00b7 \u2193 387 tok\u001b[0;38;5;102m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[0;38;5;178mLaunch t3.large EC2 and test Postgres database\u001b[0;38;5;102m \r\u001b[117C\u2500\u001b[0m\r\r\n\u001b[0;38;5;136;3m\u26a0 \u276f \u001b[0m\r\r\n\u001b[0;38;5;102m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u25