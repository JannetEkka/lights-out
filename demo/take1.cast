[41.9933, "o", "\u001b[?25l\u001b[?7l\u001b[A\u001b[4D\u001b[0;38;5;173m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m\u001b[K\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;214;1m\u26a0\ufe0f  Dangerous Command                                            \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502                                                                  \u2502\u001b[0m\u001b[K\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;136;3m<terminal> (plugin approval rule)                               \u001b[0;38;5;173m \u2502\u001b[0m\u001b[K\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502                                                                  \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;220;1m\u276f 1. Allow once                                                 \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;136m  2. Allow for this session                                     \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;136m  3. Add to permanent allowlist                                 \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;136m  4. Deny                                                       \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502                                                                  \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;230;1mLights Out: this starts 1 RDS db.t3.micro postgres: about       \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;230;1m$15.44/month incl. 20 G