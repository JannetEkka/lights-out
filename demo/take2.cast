[38.4006, "o", "\u001b[?25l\u001b[?7l\u001b[A\u001b[4D\u001b[0;38;5;173m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m\u001b[K\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;214;1m\u26a0\ufe0f  Dangerous Command                                            \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502                                                                  \u2502\u001b[0m\u001b[K\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;136;3m<terminal> (plugin approval rule)                               \u001b[0;38;5;173m \u2502\u001b[0m\u001b[K\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502                                                                  \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;220;1m\u276f 1. Allow once                                                 \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;136m  2. Allow for this session                                     \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;136m  3. Add to permanent allowlist                                 \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;136m  4. Deny                                                       \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502                                                                  \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;230;1mLights Out: this starts 1 RDS db.t3.micro postgres: about       \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;230;1m$15.44/month incl. 20 GiB storage, billed until deleted. To keep\u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2502 \u001b[0;38;5;230;1m it past this session: /lights keep <id> <date>.                \u001b[0;38;5;173m \u2502\u001b[0m\r\r\n\u001b[0;38;5;173m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\r\r\n\u001b[0m \u001b[0m\r\r\n\u001b[0;38;5;136;3m  \u2191/\u2193 to select, Enter to confirm\u001b[0;38;5;173m  (299s)\u001b[0m\r\r\n\u001b[0;38;5;102m\u2500\u2500 \u2819 \ud83d\udcbb aws ec2 run-instances --image-id ami-12345678 --instance-type t3.large --tag-specifications 'ResourceType=i..\r\u001b[117C.\u001b[0m\r\r\n\u001b[0;38;5;136;3m\u26a0 \u276f \u001b[0m\r\r\n\u001b[0;38;5;102m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[117C\u2500\u001b[0m\r\r\n\u001b[0;38;5;250m \u2624 \u001b[0;38;5;220;1mnemotron-3-ultra-550b-a55b\u001b[0;38;5;101m \u00b7 13.8K/1M \u00b7 \u001b[0;38;5;108;1m[\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591]\u001b[0;38;